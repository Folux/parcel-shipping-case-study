# Local environment for the Databricks Asset Bundle.
# Copy to .env (gitignored) and fill in your values, then: `source .env`
#
#   cp .env.example .env

# The auth profile created by `databricks auth login` (run `databricks auth profiles`
# to see its name). This is how the bundle finds your workspace host — nothing
# workspace-specific is committed to the repo.
export DATABRICKS_CONFIG_PROFILE=DEFAULT

# SQL warehouse ID = last segment of the warehouse's HTTP path:
#   /sql/1.0/warehouses/<id>
# Supplied to the bundle as the `warehouse_id` variable.
export BUNDLE_VAR_warehouse_id=PUT-YOUR-WAREHOUSE-ID-HERE
